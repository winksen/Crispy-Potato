{
  "name": "crispy-potato",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @crispy-potato/storybook dev",
    "build": "pnpm --filter @crispy-potato/ui build",
    "build:storybook": "pnpm --filter @crispy-potato/storybook build",
    "test": "pnpm --filter @crispy-potato/ui test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "typescript": "7.0.2"
  }
}
