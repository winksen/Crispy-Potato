  "query": "SELECT s.id,s.schedule_seconds,r.status,r.started_at::text AS last_run,r.finished_at::text AS finished_at,r.errors FROM sources s LEFT JOIN LATERAL (SELECT status,started_at,finished_at,errors FROM ingestion_runs WHERE source_id=s.id ORDER BY id DESC LIMIT 1) r ON true ORDER BY s.id",
