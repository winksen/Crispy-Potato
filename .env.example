# Local development only; choose a password before starting Postgres.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
# Export these in your shell for runtime commands after provisioning roles.
# DATABASE_URL=postgres://cp_writer:<password>@localhost:5432/crispy_potato
# API_DATABASE_URL=postgres://cp_reader:<password>@localhost:5432/crispy_potato
# DB_POOL_MAX_CONNECTIONS=5
# DB_ACQUIRE_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000
# Reader connections default to and are capped at 5000 ms.
# Optional collection credentials; export in your shell, never commit values.
# GITHUB_TOKEN=
# GITHUB_TOKEN_FILE=/run/secrets/github_token
# STACKEXCHANGE_KEY=
# STACKEXCHANGE_KEY_FILE=/run/secrets/stackexchange_key
