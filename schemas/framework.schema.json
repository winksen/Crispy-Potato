{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "DomainFit": {
      "additionalProperties": false,
      "description": "How well an entity suits one kind of project.",
      "properties": {
        "domain": {
          "description": "A value from `content/vocab/domains.yaml`.",
          "enum": [
            "web-frontend",
            "web-backend",
            "mobile",
            "desktop",
            "systems",
            "embedded",
            "cli",
            "scripting",
            "devops",
            "data-science",
            "machine-learning",
            "scientific",
            "games"
          ],
          "enumDescriptions": [
            "Web frontend: User interfaces that run in the browser.",
            "Web backend: Servers and APIs behind websites and apps.",
            "Mobile: Apps for iOS and Android.",
            "Desktop: Applications for Windows, macOS and Linux.",
            "Systems: Operating systems, databases, compilers and other low-level software.",
            "Embedded: Firmware and software for microcontrollers and other devices.",
            "Command-line tools: Programs used from a terminal.",
            "Scripting and automation: Small programs that glue tools together or automate tasks.",
            "DevOps and infrastructure: Deployment, cloud infrastructure and operations tooling.",
            "Data science: Analyzing, cleaning and visualizing data.",
            "Machine learning: Training and serving models.",
            "Scientific computing: Simulation and numerical work in research and engineering.",
            "Games: Game engines and the games built with them."
          ],
          "maxLength": 256,
          "type": "string"
        },
        "fit": {
          "$ref": "#/definitions/Fit"
        },
        "note": {
          "description": "Required when `fit` is `possible` or `poor`.",
          "maxLength": 2000,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "domain",
        "fit"
      ],
      "type": "object"
    },
    "ExternalIds": {
      "additionalProperties": false,
      "description": "How the engine finds this entity in each external source.",
      "properties": {
        "crates": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "endoflife": {
          "description": "The endoflife.date product slug.",
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "github": {
          "description": "`owner/repo`.",
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "hex": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "maven": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "npm": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "nuget": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "packagist": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "pub": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "pypi": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "rubygems": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "simple_icons": {
          "description": "The Simple Icons slug the web app shows as the logo. The icons are CC0\nand come from the simple-icons package; no SVG is stored here.",
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "so_survey": {
          "anyOf": [
            {
              "$ref": "#/definitions/SurveyName"
            },
            {
              "type": "null"
            }
          ],
          "description": "The name used in the Stack Overflow Developer Survey."
        },
        "stackoverflow_tag": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        },
        "wikidata": {
          "maxLength": 256,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Fit": {
      "enum": [
        "excellent",
        "good",
        "possible",
        "poor"
      ],
      "maxLength": 256,
      "type": "string"
    },
    "FrameworkTraits": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "default": [],
          "items": {
            "enum": [
              "component",
              "mvc",
              "minimal",
              "batteries-included",
              "meta-framework"
            ],
            "enumDescriptions": [
              "Component-based: The UI is built from reusable, self-contained components.",
              "MVC: Code is split into models, views and controllers.",
              "Minimal: A small core that leaves most choices to the developer.",
              "Batteries included: Ships with most of what a typical app needs, such as an ORM, authentication and templating.",
              "Meta-framework: Builds on another framework to add routing, server rendering and deployment."
            ],
            "maxLength": 256,
            "type": "string"
          },
          "type": "array"
        },
        "ecosystem": {
          "description": "A value from `content/vocab/domains.yaml`.",
          "enum": [
            "web-frontend",
            "web-backend",
            "mobile",
            "desktop",
            "systems",
            "embedded",
            "cli",
            "scripting",
            "devops",
            "data-science",
            "machine-learning",
            "scientific",
            "games"
          ],
          "enumDescriptions": [
            "Web frontend: User interfaces that run in the browser.",
            "Web backend: Servers and APIs behind websites and apps.",
            "Mobile: Apps for iOS and Android.",
            "Desktop: Applications for Windows, macOS and Linux.",
            "Systems: Operating systems, databases, compilers and other low-level software.",
            "Embedded: Firmware and software for microcontrollers and other devices.",
            "Command-line tools: Programs used from a terminal.",
            "Scripting and automation: Small programs that glue tools together or automate tasks.",
            "DevOps and infrastructure: Deployment, cloud infrastructure and operations tooling.",
            "Data science: Analyzing, cleaning and visualizing data.",
            "Machine learning: Training and serving models.",
            "Scientific computing: Simulation and numerical work in research and engineering.",
            "Games: Game engines and the games built with them."
          ],
          "maxLength": 256,
          "type": "string"
        },
        "languages": {
          "description": "Ids of language entities.",
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "type": "array"
        },
        "platforms": {
          "default": [],
          "items": {
            "enum": [
              "ios",
              "android",
              "web",
              "desktop"
            ],
            "enumDescriptions": [
              "iOS: Builds apps for iPhone and iPad.",
              "Android: Builds apps for Android devices.",
              "Web: Builds apps that run in the browser.",
              "Desktop: Builds apps for Windows, macOS or Linux."
            ],
            "maxLength": 256,
            "type": "string"
          },
          "type": "array"
        },
        "rendering": {
          "default": [],
          "items": {
            "enum": [
              "csr",
              "ssr",
              "ssg",
              "native",
              "own-renderer"
            ],
            "enumDescriptions": [
              "Client-side rendering: Pages are rendered in the browser with JavaScript.",
              "Server-side rendering: Pages are rendered on the server for each request.",
              "Static generation: Pages are rendered once at build time.",
              "Native views: The UI is drawn with the platform's own UI components.",
              "Own renderer: The framework draws every pixel itself instead of using platform UI components."
            ],
            "maxLength": 256,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "ecosystem",
        "languages"
      ],
      "type": "object"
    },
    "Kind": {
      "description": "What an entity is on the site. Each kind has its own folder under `content/`.",
      "enum": [
        "language",
        "framework",
        "runtime"
      ],
      "maxLength": 256,
      "type": "string"
    },
    "Learning": {
      "additionalProperties": false,
      "properties": {
        "curve": {
          "$ref": "#/definitions/LearningCurve"
        },
        "resources": {
          "items": {
            "$ref": "#/definitions/Resource"
          },
          "type": "array"
        }
      },
      "required": [
        "curve",
        "resources"
      ],
      "type": "object"
    },
    "LearningCurve": {
      "enum": [
        "gentle",
        "moderate",
        "steep"
      ],
      "maxLength": 256,
      "type": "string"
    },
    "Links": {
      "additionalProperties": false,
      "properties": {
        "docs": {
          "format": "uri",
          "maxLength": 2048,
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "format": "uri",
          "maxLength": 2048,
          "type": [
            "string",
            "null"
          ]
        },
        "website": {
          "format": "uri",
          "maxLength": 2048,
          "type": "string"
        }
      },
      "required": [
        "website"
      ],
      "type": "object"
    },
    "Milestone": {
      "additionalProperties": false,
      "description": "A milestone that is not a release. Releases are collected automatically.",
      "properties": {
        "date": {
          "$ref": "#/definitions/PartialDate"
        },
        "title": {
          "maxLength": 200,
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2048,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "date",
        "title"
      ],
      "type": "object"
    },
    "NotableUser": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "type": "string"
        },
        "source": {
          "format": "uri",
          "maxLength": 2048,
          "type": "string"
        },
        "what": {
          "description": "What they use it for.",
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "name",
        "what",
        "source"
      ],
      "type": "object"
    },
    "Override": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "maxLength": 2000,
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/PartialDate"
        }
      },
      "required": [
        "value",
        "reason"
      ],
      "type": "object"
    },
    "Override2": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "maxLength": 2000,
          "type": "string"
        },
        "value": {
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "value",
        "reason"
      ],
      "type": "object"
    },
    "Overrides": {
      "additionalProperties": false,
      "description": "Corrections to facts the engine collects, for when a source is wrong.",
      "properties": {
        "designers": {
          "anyOf": [
            {
              "$ref": "#/definitions/Override2"
            },
            {
              "type": "null"
            }
          ]
        },
        "developer": {
          "anyOf": [
            {
              "$ref": "#/definitions/Override2"
            },
            {
              "type": "null"
            }
          ]
        },
        "inception": {
          "anyOf": [
            {
              "$ref": "#/definitions/Override"
            },
            {
              "type": "null"
            }
          ]
        },
        "influenced_by": {
          "anyOf": [
            {
              "$ref": "#/definitions/Override2"
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/definitions/Override2"
            },
            {
              "type": "null"
            }
          ]
        },
        "written_in": {
          "anyOf": [
            {
              "$ref": "#/definitions/Override2"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "PartialDate": {
      "description": "A date known to the year, the month or the day: 2006, 2013-05 or 2015-05-15.",
      "maxLength": 256,
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$",
      "type": [
        "string",
        "integer"
      ]
    },
    "Point": {
      "additionalProperties": false,
      "description": "A strength or a weakness.",
      "properties": {
        "detail": {
          "maxLength": 2000,
          "type": "string"
        },
        "sources": {
          "default": [],
          "items": {
            "format": "uri",
            "maxLength": 2048,
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "type": "string"
        }
      },
      "required": [
        "title",
        "detail"
      ],
      "type": "object"
    },
    "Relations": {
      "additionalProperties": false,
      "description": "Links to other entities, by id. Each relation is written on one side only;\nthe engine derives the reverse direction.",
      "properties": {
        "alternatives": {
          "default": [],
          "description": "Symmetric. Must have the same kind.",
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "type": "array"
        },
        "built_on": {
          "default": [],
          "description": "This entity is built on the target, e.g. `nextjs` → `react`.",
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "type": "array"
        },
        "often_with": {
          "default": [],
          "description": "Symmetric, e.g. `react` ↔ `typescript`.",
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "type": "array"
        },
        "runs_on": {
          "default": [],
          "description": "This entity runs on the target runtime, e.g. `express` → `nodejs`.",
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "type": "array"
        },
        "succeeded_by": {
          "default": [],
          "description": "This entity was replaced by the target, e.g. `angularjs` → `angular`.",
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "free": {
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/definitions/ResourceKind"
        },
        "title": {
          "maxLength": 200,
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2048,
          "type": "string"
        }
      },
      "required": [
        "title",
        "url",
        "kind",
        "free"
      ],
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "book",
        "course",
        "docs",
        "exercises",
        "tutorial",
        "video"
      ],
      "maxLength": 256,
      "type": "string"
    },
    "SurveyName": {
      "anyOf": [
        {
          "description": "The same name in every survey year.",
          "maxLength": 60,
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Each name with the first survey year that used it, such as\n`{2022: React.js, 2023: React}`. A name applies until the next year listed.",
          "patternProperties": {
            "^\\d+$": {
              "maxLength": 60,
              "type": "string"
            }
          },
          "type": "object"
        }
      ],
      "description": "The name a technology has in the Stack Overflow Developer Survey, which\nsometimes renames technologies between years."
    }
  },
  "description": "A curated entity, as written in a `content/` YAML file.\n\n`T` holds the kind-specific traits. Files are parsed as `Entity<LanguageTraits>`,\n`Entity<FrameworkTraits>` and so on, then converted to `Entity<Traits>`.",
  "properties": {
    "aliases": {
      "default": [],
      "items": {
        "maxLength": 100,
        "type": "string"
      },
      "type": "array"
    },
    "choose_when": {
      "description": "2–4 situations that each complete the sentence \"Choose <name> when …\",\nshown side by side on compare pages.",
      "items": {
        "maxLength": 140,
        "type": "string"
      },
      "type": "array"
    },
    "domains": {
      "items": {
        "$ref": "#/definitions/DomainFit"
      },
      "type": "array"
    },
    "id": {
      "maxLength": 256,
      "type": "string"
    },
    "ids": {
      "$ref": "#/definitions/ExternalIds"
    },
    "kind": {
      "const": "framework"
    },
    "learning": {
      "$ref": "#/definitions/Learning"
    },
    "links": {
      "$ref": "#/definitions/Links"
    },
    "name": {
      "maxLength": 100,
      "type": "string"
    },
    "notable_users": {
      "default": [],
      "items": {
        "$ref": "#/definitions/NotableUser"
      },
      "type": "array"
    },
    "overrides": {
      "allOf": [
        {
          "$ref": "#/definitions/Overrides"
        }
      ],
      "default": {
        "designers": null,
        "developer": null,
        "inception": null,
        "influenced_by": null,
        "license": null,
        "written_in": null
      }
    },
    "relations": {
      "allOf": [
        {
          "$ref": "#/definitions/Relations"
        }
      ],
      "default": {
        "alternatives": [],
        "built_on": [],
        "often_with": [],
        "runs_on": [],
        "succeeded_by": []
      }
    },
    "samples": {
      "default": [],
      "description": "Paths relative to `content/samples/`.",
      "items": {
        "maxLength": 256,
        "type": "string"
      },
      "type": "array"
    },
    "strengths": {
      "items": {
        "$ref": "#/definitions/Point"
      },
      "type": "array"
    },
    "summary": {
      "maxLength": 4000,
      "type": "string"
    },
    "tagline": {
      "maxLength": 100,
      "type": "string"
    },
    "timeline": {
      "default": [],
      "items": {
        "$ref": "#/definitions/Milestone"
      },
      "type": "array"
    },
    "traits": {
      "$ref": "#/definitions/FrameworkTraits"
    },
    "weaknesses": {
      "items": {
        "$ref": "#/definitions/Point"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "kind",
    "name",
    "tagline",
    "summary",
    "links",
    "ids",
    "traits",
    "domains",
    "strengths",
    "weaknesses",
    "choose_when",
    "learning"
  ],
  "title": "A framework in content/frameworks/",
  "type": "object"
}
